[Unit]
Description=Feral File Connectd
After=feral-sys-monitord.service chromium-ready.target
Requires=chromium-kiosk.service feral-sys-monitord.service
Wants=network.target

[Service]
Type=notify
User=feralfile
Group=feralfile
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus"
Environment="WAYLAND_DISPLAY=wayland-0"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
ExecStart=/usr/bin/feral-connectd
Restart=always
RestartSec=5
WatchdogSec=30s
StandardOutput=append:/home/feralfile/.logs/connectd.log
StandardError=append:/home/feralfile/.logs/connectd.log

[Install]
WantedBy=multi-user.target